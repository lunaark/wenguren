.intro-page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% 30%, rgba(184, 150, 62, 0.08) 0%, transparent 50%),
    var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
}

.intro-container {
  text-align: center;
  padding: 0 60rpx 80rpx;
  max-width: 100%;
}

.intro-dynasty {
  display: block;
  font-size: 24rpx;
  letter-spacing: 0.5em;
  color: var(--ink-faint);
  margin-bottom: 32rpx;
  opacity: 0;
  animation: fadeInUp 800ms ease 200ms forwards;
}

.intro-name {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.15em;
  margin-bottom: 40rpx;
  opacity: 0;
  animation: fadeInUp 800ms ease 400ms forwards;
}

.intro-divider {
  width: 120rpx;
  height: 2rpx;
  background: var(--accent-gold);
  margin: 0 auto 40rpx;
  opacity: 0;
  animation: fadeInUp 800ms ease 600ms forwards;
}

.intro-quote {
  display: block;
  font-size: 28rpx;
  color: var(--accent-vermilion);
  font-style: italic;
  letter-spacing: 0.08em;
  margin-bottom: 48rpx;
  line-height: 1.8;
  opacity: 0;
  animation: fadeInUp 800ms ease 800ms forwards;
}

.intro-desc {
  display: block;
  font-size: 28rpx;
  color: var(--ink-light);
  line-height: 2;
  margin-bottom: 40rpx;
  text-align: justify;
  opacity: 0;
  animation: fadeInUp 800ms ease 1000ms forwards;
}

.intro-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 60rpx;
  opacity: 0;
  animation: fadeInUp 800ms ease 1200ms forwards;
}

.meta-item {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.meta-dot {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.btn-start {
  display: inline-block;
  padding: 24rpx 80rpx;
  border: 1rpx solid var(--ink-light);
  color: var(--ink);
  font-size: 30rpx;
  letter-spacing: 0.3em;
  border-radius: 8rpx;
  margin-bottom: 32rpx;
  transition: all 300ms ease;
  opacity: 0;
  animation: fadeInUp 800ms ease 1400ms forwards;
}

.btn-start:active {
  background: var(--ink);
  color: var(--paper);
}

.btn-back {
  opacity: 0;
  animation: fadeInUp 800ms ease 1600ms forwards;
}

.btn-back text {
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.2em;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
