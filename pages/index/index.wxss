.index-page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 30% 20%, rgba(184, 150, 62, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(91, 140, 111, 0.04) 0%, transparent 50%),
    var(--paper);
}

.safe-area {
  padding: 0 40rpx 80rpx;
}

/* === 顶部标题 === */
.header {
  text-align: center;
  padding: 60rpx 0 48rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.15em;
  margin-bottom: 12rpx;
}

.slogan {
  display: block;
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.3em;
}

/* === 主推卡片 === */
.main-card {
  position: relative;
  padding: 48rpx 40rpx;
  background: var(--paper-warm);
  border: 1rpx solid rgba(42, 31, 26, 0.08);
  border-radius: 12rpx;
  margin-bottom: 48rpx;
  transition: all 300ms ease;
  overflow: hidden;
}

/* === 装饰大字 === */
.card-glyph {
  position: absolute;
  right: -10rpx;
  top: 16rpx;
  font-size: 240rpx;
  font-weight: 900;
  line-height: 1;
  pointer-events: none;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}

.main-card:active {
  background: var(--paper-deep);
}

.card-dynasty {
  display: block;
  font-size: 22rpx;
  color: var(--accent-gold);
  letter-spacing: 0.3em;
  margin-bottom: 16rpx;
}

.card-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.1em;
  margin-bottom: 12rpx;
}

.card-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--ink-light);
  margin-bottom: 24rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.meta-dot {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.card-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 6rpx 16rpx;
  background: rgba(91, 140, 111, 0.15);
  border-radius: 6rpx;
}

.card-badge text {
  font-size: 20rpx;
  color: var(--accent-jade);
  letter-spacing: 0.1em;
}

/* === 多篇章卡片 === */
.multi-card {
  padding-bottom: 16rpx;
}

.multi-card .card-name {
  margin-bottom: 24rpx;
}

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.chapter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(42, 31, 26, 0.06);
}

.chapter-item:active {
  background: rgba(42, 31, 26, 0.03);
  margin: 0 -40rpx;
  padding: 24rpx 40rpx;
}

.chapter-left {
  flex: 1;
  min-width: 0;
}

.chapter-label {
  display: block;
  font-size: 22rpx;
  color: var(--accent-vermilion);
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}

.chapter-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--ink-light);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chapter-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 24rpx;
}

.chapter-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chapter-badge {
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(91, 140, 111, 0.15);
  border-radius: 4rpx;
}

.chapter-badge text {
  font-size: 18rpx;
  color: var(--accent-jade);
  letter-spacing: 0.1em;
}

/* === 即将上线 === */
.section-label {
  margin-bottom: 24rpx;
}

.section-label text {
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.2em;
}

.coming-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.coming-card {
  padding: 32rpx 24rpx;
  background: rgba(226, 213, 191, 0.3);
  border: 1rpx solid rgba(42, 31, 26, 0.06);
  border-radius: 8rpx;
  opacity: 0.6;
}

.coming-dynasty {
  display: block;
  font-size: 20rpx;
  color: var(--accent-gold);
  letter-spacing: 0.2em;
  margin-bottom: 8rpx;
}

.coming-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink-light);
  margin-bottom: 8rpx;
}

.coming-subtitle {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
}
