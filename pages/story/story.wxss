.story-page {
  min-height: 100vh;
  background: var(--paper);
  position: relative;
}

/* === 进度条 === */
.progress-bar {
  position: fixed;
  top: 0;
  left: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--accent-gold), var(--accent-vermilion));
  z-index: 999;
  transition: width 600ms ease;
}

/* === 粘性顶栏 === */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(244, 237, 224, 0.92);
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid rgba(42, 31, 26, 0.06);
}

.header-inner {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

/* === 返回按钮 === */
.header-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 12rpx;
}

.back-arrow {
  font-size: 40rpx;
  color: var(--ink-faint);
  font-weight: 300;
  line-height: 1;
}

.header-chapter {
  font-size: 24rpx;
  letter-spacing: 0.3em;
  color: var(--ink-faint);
}

/* === 年代标签（内容区顶部，居中） === */
.year-tag {
  text-align: center;
  margin-bottom: 40rpx;
}

.year-tag text {
  display: inline-block;
  padding: 8rpx 28rpx;
  background: rgba(184, 150, 62, 0.1);
  border: 1rpx solid rgba(184, 150, 62, 0.25);
  border-radius: 6rpx;
  font-size: 22rpx;
  color: var(--accent-gold);
  letter-spacing: 0.15em;
}

/* === 内容区 === */
.body {
  max-width: 100%;
  padding: 60rpx 48rpx 120rpx;
}

/* === 淡入动画 === */
.anim-fade {
  opacity: 0;
  transform: translateY(30rpx);
  animation: fadeInUp 500ms ease forwards;
}

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* === 氛围描写 === */
.scene-atmosphere {
  font-size: 26rpx;
  color: var(--ink-faint);
  font-style: italic;
  border-left: 4rpx solid var(--accent-gold);
  padding-left: 24rpx;
  margin-bottom: 48rpx;
  line-height: 1.9;
}

/* === 正文叙述 === */
.scene-narration {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 2.0;
  margin-bottom: 40rpx;
  text-align: justify;
}

/* === 对话 === */
.scene-dialogue {
  margin: 40rpx 0;
  padding: 32rpx 36rpx;
  background: rgba(226, 213, 191, 0.4);
  border-radius: 8rpx;
}

.dialogue-speaker {
  display: block;
  font-size: 24rpx;
  color: var(--accent-vermilion);
  letter-spacing: 0.15em;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.dialogue-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--ink);
}

/* === 时间过渡 === */
.scene-transition {
  text-align: center;
  padding: 80rpx 40rpx;
}

.transition-year {
  display: block;
  font-size: 56rpx;
  font-weight: 200;
  color: var(--accent-gold);
  letter-spacing: 0.2em;
  margin-bottom: 12rpx;
}

.transition-desc {
  display: block;
  font-size: 26rpx;
  color: var(--ink-faint);
  letter-spacing: 0.15em;
}

/* === 分隔符 === */
.scene-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 0;
  gap: 20rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(42, 31, 26, 0.1), transparent);
}

.divider-diamond {
  font-size: 16rpx;
  color: var(--accent-gold);
}

/* === 诗词展示 === */
.scene-poem {
  text-align: center;
  padding: 60rpx 32rpx;
  margin: 48rpx 0;
  background: rgba(226, 213, 191, 0.2);
  border-radius: 8rpx;
  border-top: 2rpx solid rgba(184, 150, 62, 0.3);
  border-bottom: 2rpx solid rgba(184, 150, 62, 0.3);
}

.poem-title {
  display: block;
  font-size: 26rpx;
  color: var(--ink-faint);
  letter-spacing: 0.2em;
  margin-bottom: 36rpx;
  font-weight: 600;
}

.poem-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.poem-line {
  display: block;
  font-size: 32rpx;
  line-height: 2.2;
  color: var(--ink);
}

.poem-note {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 32rpx;
  letter-spacing: 0.1em;
}

/* === 选择按钮区 === */
.choices-container {
  margin-top: 60rpx;
}

.choices-prompt {
  display: block;
  font-size: 24rpx;
  letter-spacing: 0.3em;
  color: var(--ink-faint);
  text-align: center;
  margin-bottom: 32rpx;
}

.choice-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 36rpx;
  margin-bottom: 20rpx;
  background: rgba(244, 237, 224, 0.6);
  border: 1rpx solid rgba(42, 31, 26, 0.12);
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  text-align: left;
  position: relative;
  transition: all 300ms ease;
}

.choice-btn::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  background: var(--accent-gold);
  border-radius: 8rpx 0 0 8rpx;
  transform: scaleY(0);
  transition: transform 300ms ease;
}

.choice-btn:active {
  background: rgba(226, 213, 191, 0.5);
  border-color: var(--accent-gold);
}

.choice-btn:active::after {
  transform: scaleY(1);
}

/* === 继续按钮 === */
.continue-container {
  margin-top: 60rpx;
  text-align: center;
}

.btn-continue {
  display: inline-block;
  padding: 20rpx 80rpx;
  background: transparent;
  border: 1rpx solid rgba(42, 31, 26, 0.2);
  color: var(--ink-light);
  font-size: 28rpx;
  letter-spacing: 0.3em;
  border-radius: 8rpx;
  transition: all 300ms ease;
}

.btn-continue:active {
  border-color: var(--ink-light);
  color: var(--ink);
  background: rgba(226, 213, 191, 0.3);
}

/* === 底部留白 === */
.bottom-spacer {
  height: 120rpx;
}

/* === 性格提示闪现 === */
.personality-flash {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%) translateY(30rpx);
  padding: 16rpx 36rpx;
  background: rgba(42, 31, 26, 0.85);
  color: var(--paper);
  font-size: 24rpx;
  border-radius: 8rpx;
  opacity: 0;
  transition: all 500ms ease;
  z-index: 200;
  letter-spacing: 0.05em;
  pointer-events: none;
  white-space: nowrap;
}

.personality-flash.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
